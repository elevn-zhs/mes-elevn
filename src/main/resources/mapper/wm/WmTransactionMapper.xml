<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    库存事务 / 流水账（wm_transaction）


    【流水表与库存表的关系】
      wm_material_stock  = 余额（只放当前还剩多少）
      wm_transaction     = 流水（每一次变动都留一条，只追加不修改）
      对账口径：某个物料某段时间的流水求和 == 库存余额的变化。
      所以这里没有 update 数量、没有 delete，写错了靠反向单冲。

    【方向记在 transaction_flag，数量永远是正数】
      入 = 1，出 = -1。若把方向做进数量（出库记 -50），
      统计时 一列正负混着加，出错概率高得多，而且"出库了多少"要加个 abs 才看得懂。

    【调拨是两条】
      源仓一条（flag = -1）、目标仓一条（flag = 1），
      再用 related_transaction_id 互指。只写一条的话，总量就凭空少了。

    【日期区间查询用的是两个非表字段】
      transaction_date_start / transaction_date_end，只参与 where，不落库。
-->
<mapper namespace="com.elevn.mes.wm.mapper.WmTransactionMapper">

    <!-- wm_transaction 表字段与实体属性的映射 -->
    <resultMap id="WmTransactionResultMap" type="com.elevn.mes.wm.entity.WmTransaction">
        <id column="transaction_id" property="transactionId"/>
        <result column="transaction_type" property="transactionType"/>
        <result column="item_id" property="itemId"/>
        <result column="item_code" property="itemCode"/>
        <result column="item_name" property="itemName"/>
        <result column="specification" property="specification"/>
        <result column="unit_of_measure" property="unitOfMeasure"/>
        <result column="unit_name" property="unitName"/>
        <result column="batch_id" property="batchId"/>
        <result column="batch_code" property="batchCode"/>
        <result column="warehouse_id" property="warehouseId"/>
        <result column="warehouse_code" property="warehouseCode"/>
        <result column="warehouse_name" property="warehouseName"/>
        <result column="location_id" property="locationId"/>
        <result column="location_code" property="locationCode"/>
        <result column="location_name" property="locationName"/>
        <result column="area_id" property="areaId"/>
        <result column="area_code" property="areaCode"/>
        <result column="area_name" property="areaName"/>
        <result column="package_id" property="packageId"/>
        <result column="package_code" property="packageCode"/>
        <result column="source_doc_type" property="sourceDocType"/>
        <result column="source_doc_id" property="sourceDocId"/>
        <result column="source_doc_code" property="sourceDocCode"/>
        <result column="source_doc_line_id" property="sourceDocLineId"/>
        <result column="material_stock_id" property="materialStockId"/>
        <result column="transaction_flag" property="transactionFlag"/>
        <result column="transaction_quantity" property="transactionQuantity"/>
        <result column="transaction_date" property="transactionDate"/>
        <result column="related_transaction_id" property="relatedTransactionId"/>
        <result column="erp_date" property="erpDate"/>
        <result column="recpt_date" property="recptDate"/>
        <result column="del_flag" property="delFlag"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <!-- 非表字段：按类型统计时算出来的 -->
        <result column="in_quantity" property="inQuantity"/>
        <result column="out_quantity" property="outQuantity"/>
        <result column="net_quantity" property="netQuantity"/>
        <result column="record_count" property="recordCount"/>
    </resultMap>

    <!-- 公共字段列表 -->
    <sql id="Base_Column_List">
        transaction_id, transaction_type,
        item_id, item_code, item_name, specification, unit_of_measure, unit_name,
        batch_id, batch_code,
        warehouse_id, warehouse_code, warehouse_name,
        location_id, location_code, location_name,
        area_id, area_code, area_name, package_id, package_code,
        source_doc_type, source_doc_id, source_doc_code, source_doc_line_id,
        material_stock_id, transaction_flag, transaction_quantity, transaction_date,
        related_transaction_id, erp_date, recpt_date, del_flag,
        create_by, create_time, update_by, update_time
    </sql>

    <!-- 新增流水 -->
    <insert id="insert" parameterType="com.elevn.mes.wm.entity.WmTransaction"
            useGeneratedKeys="true" keyProperty="transactionId">
        insert into wm_transaction
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="transactionType != null and transactionType != ''">transaction_type,</if>
            <if test="itemId != null">item_id,</if>
            <if test="itemCode != null and itemCode != ''">item_code,</if>
            <if test="itemName != null and itemName != ''">item_name,</if>
            <if test="specification != null and specification != ''">specification,</if>
            <if test="unitOfMeasure != null and unitOfMeasure != ''">unit_of_measure,</if>
            <if test="unitName != null and unitName != ''">unit_name,</if>
            <if test="batchId != null">batch_id,</if>
            <if test="batchCode != null and batchCode != ''">batch_code,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="warehouseCode != null and warehouseCode != ''">warehouse_code,</if>
            <if test="warehouseName != null and warehouseName != ''">warehouse_name,</if>
            <if test="locationId != null">location_id,</if>
            <if test="locationCode != null and locationCode != ''">location_code,</if>
            <if test="locationName != null and locationName != ''">location_name,</if>
            <if test="areaId != null">area_id,</if>
            <if test="areaCode != null and areaCode != ''">area_code,</if>
            <if test="areaName != null and areaName != ''">area_name,</if>
            <if test="packageId != null">package_id,</if>
            <if test="packageCode != null and packageCode != ''">package_code,</if>
            <if test="sourceDocType != null and sourceDocType != ''">source_doc_type,</if>
            <if test="sourceDocId != null">source_doc_id,</if>
            <if test="sourceDocCode != null and sourceDocCode != ''">source_doc_code,</if>
            <if test="sourceDocLineId != null">source_doc_line_id,</if>
            <if test="materialStockId != null">material_stock_id,</if>
            <if test="transactionFlag != null">transaction_flag,</if>
            <if test="transactionQuantity != null">transaction_quantity,</if>
            <if test="transactionDate != null">transaction_date,</if>
            <if test="relatedTransactionId != null">related_transaction_id,</if>
            <if test="erpDate != null">erp_date,</if>
            <if test="recptDate != null">recpt_date,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="transactionType != null and transactionType != ''">#{transactionType},</if>
            <if test="itemId != null">#{itemId},</if>
            <if test="itemCode != null and itemCode != ''">#{itemCode},</if>
            <if test="itemName != null and itemName != ''">#{itemName},</if>
            <if test="specification != null and specification != ''">#{specification},</if>
            <if test="unitOfMeasure != null and unitOfMeasure != ''">#{unitOfMeasure},</if>
            <if test="unitName != null and unitName != ''">#{unitName},</if>
            <if test="batchId != null">#{batchId},</if>
            <if test="batchCode != null and batchCode != ''">#{batchCode},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="warehouseCode != null and warehouseCode != ''">#{warehouseCode},</if>
            <if test="warehouseName != null and warehouseName != ''">#{warehouseName},</if>
            <if test="locationId != null">#{locationId},</if>
            <if test="locationCode != null and locationCode != ''">#{locationCode},</if>
            <if test="locationName != null and locationName != ''">#{locationName},</if>
            <if test="areaId != null">#{areaId},</if>
            <if test="areaCode != null and areaCode != ''">#{areaCode},</if>
            <if test="areaName != null and areaName != ''">#{areaName},</if>
            <if test="packageId != null">#{packageId},</if>
            <if test="packageCode != null and packageCode != ''">#{packageCode},</if>
            <if test="sourceDocType != null and sourceDocType != ''">#{sourceDocType},</if>
            <if test="sourceDocId != null">#{sourceDocId},</if>
            <if test="sourceDocCode != null and sourceDocCode != ''">#{sourceDocCode},</if>
            <if test="sourceDocLineId != null">#{sourceDocLineId},</if>
            <if test="materialStockId != null">#{materialStockId},</if>
            <if test="transactionFlag != null">#{transactionFlag},</if>
            <if test="transactionQuantity != null">#{transactionQuantity},</if>
            <if test="transactionDate != null">#{transactionDate},</if>
            <if test="relatedTransactionId != null">#{relatedTransactionId},</if>
            <if test="erpDate != null">#{erpDate},</if>
            <if test="recptDate != null">#{recptDate},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <!-- 回填配对事务ID（调拨两条流水互指，这是本表唯一的一次 update） -->
    <update id="updateRelatedTransactionId">
        update wm_transaction
        set related_transaction_id = #{relatedTransactionId}
        where transaction_id = #{transactionId}
    </update>

    <!-- 根据ID查询单条 -->
    <select id="selectById" resultMap="WmTransactionResultMap">
        select
        <include refid="Base_Column_List"/>
        from wm_transaction
        <where>
            del_flag = '0'
            and transaction_id = #{id}
        </where>
    </select>

    <!-- 多条件查询流水（库存事务页） -->
    <select id="selectByCondition" parameterType="com.elevn.mes.wm.entity.WmTransaction"
            resultMap="WmTransactionResultMap">
        select
        <include refid="Base_Column_List"/>
        from wm_transaction
        <where>
            del_flag = '0'
            <if test="transactionType != null and transactionType != ''">
                and transaction_type = #{transactionType}
            </if>
            <if test="itemId != null">and item_id = #{itemId}</if>
            <if test="itemCode != null and itemCode != ''">
                and item_code like concat('%', #{itemCode}, '%')
            </if>
            <if test="itemName != null and itemName != ''">
                and item_name like concat('%', #{itemName}, '%')
            </if>
            <if test="batchId != null">and batch_id = #{batchId}</if>
            <if test="batchCode != null and batchCode != ''">
                and batch_code like concat('%', #{batchCode}, '%')
            </if>
            <if test="warehouseId != null">and warehouse_id = #{warehouseId}</if>
            <if test="locationId != null">and location_id = #{locationId}</if>
            <if test="transactionFlag != null">and transaction_flag = #{transactionFlag}</if>
            <if test="sourceDocType != null and sourceDocType != ''">
                and source_doc_type = #{sourceDocType}
            </if>
            <if test="sourceDocId != null">and source_doc_id = #{sourceDocId}</if>
            <if test="sourceDocCode != null and sourceDocCode != ''">
                and source_doc_code like concat('%', #{sourceDocCode}, '%')
            </if>
            <if test="transactionDateStart != null">and transaction_date &gt;= #{transactionDateStart}</if>
            <if test="transactionDateEnd != null">and transaction_date &lt;= #{transactionDateEnd}</if>
        </where>
        order by transaction_id desc
    </select>

    <!--
        按物料 + 批次查流水（批次追溯）
        时间【正序】—— 追溯要看"这批货一路怎么走过来的"，正着看才是完整的故事
    -->
    <select id="selectByItemAndBatch" parameterType="com.elevn.mes.wm.entity.WmTransaction"
            resultMap="WmTransactionResultMap">
        select
        <include refid="Base_Column_List"/>
        from wm_transaction
        <where>
            del_flag = '0'
            <if test="itemId != null">and item_id = #{itemId}</if>
            <if test="batchId != null">and batch_id = #{batchId}</if>
            <if test="batchCode != null and batchCode != ''">and batch_code = #{batchCode}</if>
            <if test="warehouseId != null">and warehouse_id = #{warehouseId}</if>
            <if test="transactionDateStart != null">and transaction_date &gt;= #{transactionDateStart}</if>
            <if test="transactionDateEnd != null">and transaction_date &lt;= #{transactionDateEnd}</if>
        </where>
        order by transaction_date asc, transaction_id asc
    </select>

    <!--
        按事务类型统计进出
        入 = flag 为 1 的数量之和，出 = flag 为 -1 的数量之和，净 = 入 - 出。
        用 sum(case when ...) 一次扫表就算出来了，比按类型分组查两遍省事。
    -->
    <select id="statByType" parameterType="com.elevn.mes.wm.entity.WmTransaction"
            resultMap="WmTransactionResultMap">
        select transaction_type,
        sum(case when transaction_flag = 1 then transaction_quantity else 0 end) as in_quantity,
        sum(case when transaction_flag = -1 then transaction_quantity else 0 end) as out_quantity,
        sum(case when transaction_flag = 1 then transaction_quantity else -transaction_quantity end) as net_quantity,
        count(1) as record_count
        from wm_transaction
        <where>
            del_flag = '0'
            <if test="warehouseId != null">and warehouse_id = #{warehouseId}</if>
            <if test="itemId != null">and item_id = #{itemId}</if>
            <if test="transactionDateStart != null">and transaction_date &gt;= #{transactionDateStart}</if>
            <if test="transactionDateEnd != null">and transaction_date &lt;= #{transactionDateEnd}</if>
        </where>
        group by transaction_type
        order by transaction_type asc
    </select>

</mapper>
