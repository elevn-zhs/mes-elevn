    <!-- 回填单据编号：先插入拿主键，再按编码规则补上 -->
    <update id="updateDocCode" parameterType="com.elevn.mes.wm.entity.WmDoc">
        update wm_doc set doc_code = #{docCode}
        where doc_id = #{docId}
    </update>

    <!--
        过账：PREPARE → CONFIRMED
        where 必须带 status = 'PREPARE'，返回 0 行 = 已被别人处理过（并发防护）
    -->
    <update id="updateExecute" parameterType="com.elevn.mes.wm.entity.WmDoc">
        update wm_doc
        <set>
            status = 'CONFIRMED',
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where doc_id = #{docId}
        and del_flag = '0'
        and status = 'PREPARE'
    </update>

    <!-- 取消：PREPARE → CANCELED（同样只允许从待过账状态取消） -->
    <update id="updateCancel" parameterType="com.elevn.mes.wm.entity.WmDoc">
        update wm_doc
        <set>
            status = 'CANCELED',
            <if test="reason != null and reason != ''">reason = #{reason},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where doc_id = #{docId}
        and del_flag = '0'
        and status = 'PREPARE'
    </update>

    <!-- 调拨送达确认：CONFIRMED → FINISHED -->
    <update id="updateFinish" parameterType="com.elevn.mes.wm.entity.WmDoc">
        update wm_doc
        <set>
            status = 'FINISHED',
            confirm_flag = 'Y',
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where doc_id = #{docId}
        and del_flag = '0'
        and status = 'CONFIRMED'
    </update>

    <!-- 根据ID逻辑删除 -->
    <delete id="deleteById">
        update wm_doc set del_flag = '1'
        where doc_id = #{id}
        and del_flag = '0'
    </delete>

    <!-- 批量逻辑删除 -->
    <update id="deleteBatch">
        update wm_doc set del_flag = '1'
        where del_flag = '0'
          and doc_id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>

    <!-- 根据ID查询单条 -->
    <select id="selectById" resultMap="WmDocResultMap">
        select
        <include refid="Base_Column_List"/>,
        <include refid="Doc_Type_Name_Column"/>
        from wm_doc
        <where>
            wm_doc.del_flag = '0'
            and wm_doc.doc_id = #{id}
        </where>
    </select>

    <!--
        多条件查询单据列表
        【必带 docType】14 类单据混在一张表，不带类型条件会把所有单据倒出来
    -->
    <select id="selectByCondition" parameterType="com.elevn.mes.wm.entity.WmDoc"
            resultMap="WmDocResultMap">
        select
        <include refid="Base_Column_List"/>,
        <include refid="Doc_Type_Name_Column"/>
        from wm_doc
        <where>
            wm_doc.del_flag = '0'
            <if test="docType != null and docType != ''">and wm_doc.doc_type = #{docType}</if>
            <if test="docCode != null and docCode != ''">
                and wm_doc.doc_code like concat('%', #{docCode}, '%')
            </if>
            <if test="docName != null and docName != ''">
                and wm_doc.doc_name like concat('%', #{docName}, '%')
            </if>
            <if test="ioFlag != null and ioFlag != ''">and wm_doc.io_flag = #{ioFlag}</if>
            <if test="status != null and status != ''">and wm_doc.status = #{status}</if>
            <if test="partnerType != null and partnerType != ''">and wm_doc.partner_type = #{partnerType}</if>
            <if test="partnerId != null">and wm_doc.partner_id = #{partnerId}</if>
            <if test="partnerName != null and partnerName != ''">
                and wm_doc.partner_name like concat('%', #{partnerName}, '%')
            </if>
            <if test="poCode != null and poCode != ''">
                and wm_doc.po_code like concat('%', #{poCode}, '%')
            </if>
            <if test="soCode != null and soCode != ''">
                and wm_doc.so_code like concat('%', #{soCode}, '%')
            </if>
            <if test="workorderId != null">and wm_doc.workorder_id = #{workorderId}</if>
            <if test="workorderCode != null and workorderCode != ''">
                and wm_doc.workorder_code like concat('%', #{workorderCode}, '%')
            </if>
            <if test="taskId != null">and wm_doc.task_id = #{taskId}</if>
            <if test="warehouseId != null">and wm_doc.warehouse_id = #{warehouseId}</if>
            <if test="sourceDocType != null and sourceDocType != ''">and wm_doc.source_doc_type = #{sourceDocType}</if>
            <if test="sourceDocId != null">and wm_doc.source_doc_id = #{sourceDocId}</if>
            <!-- 业务日期区间查询（两个非表字段） -->
            <if test="bizDateStart != null">and wm_doc.biz_date &gt;= #{bizDateStart}</if>
            <if test="bizDateEnd != null">and wm_doc.biz_date &lt;= #{bizDateEnd}</if>
        </where>
        order by wm_doc.doc_id desc
    </select>

    <!-- 统计指定状态的单据数（过账/删除前的 L3 校验） -->
    <select id="countByDocIdAndStatus" resultType="int">
        select count(1) from wm_doc
        where del_flag = '0'
          and doc_id = #{docId}
          and status = #{status}
    </select>

</mapper>
