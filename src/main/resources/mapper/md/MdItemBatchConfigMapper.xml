<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    物料批次属性配置


    说明：本文件是手写 SQL。逻辑删除需要自己在 SQL 里写 del_flag，
          每条查询都要带 del_flag = '0'，否则会把已删除的数据查出来。
-->
<mapper namespace="com.elevn.mes.md.mapper.MdItemBatchConfigMapper">

    <!-- md_item_batch_config 表字段与实体属性的映射 -->
    <resultMap id="MdItemBatchConfigResultMap" type="com.elevn.mes.md.entity.MdItemBatchConfig">
        <id column="config_id" property="configId"/>
        <result column="item_id" property="itemId"/>
        <result column="produce_date_flag" property="produceDateFlag"/>
        <result column="expire_date_flag" property="expireDateFlag"/>
        <result column="recpt_date_flag" property="recptDateFlag"/>
        <result column="vendor_flag" property="vendorFlag"/>
        <result column="client_flag" property="clientFlag"/>
        <result column="co_code_flag" property="coCodeFlag"/>
        <result column="po_code_flag" property="poCodeFlag"/>
        <result column="workorder_flag" property="workorderFlag"/>
        <result column="task_flag" property="taskFlag"/>
        <result column="workstation_flag" property="workstationFlag"/>
        <result column="tool_flag" property="toolFlag"/>
        <result column="mold_flag" property="moldFlag"/>
        <result column="lot_number_flag" property="lotNumberFlag"/>
        <result column="quality_status_flag" property="qualityStatusFlag"/>
        <result column="enable_flag" property="enableFlag"/>
        <result column="del_flag" property="delFlag"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 公共字段列表，避免每句 SQL 重复罗列 -->
    <sql id="Base_Column_List">
        config_id, item_id, produce_date_flag, expire_date_flag, recpt_date_flag,
        vendor_flag, client_flag, co_code_flag, po_code_flag, workorder_flag,
        task_flag, workstation_flag, tool_flag, mold_flag, lot_number_flag,
        quality_status_flag, enable_flag, del_flag, remark, create_by,
        create_time, update_by, update_time
    </sql>

    <!-- 新增物料批次属性配置：字段为 null 时不写入，交给数据库默认值 -->
    <insert id="insert" parameterType="com.elevn.mes.md.entity.MdItemBatchConfig" useGeneratedKeys="true" keyProperty="configId">
        insert into md_item_batch_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemId != null">item_id,</if>
            <if test="produceDateFlag != null and produceDateFlag != ''">produce_date_flag,</if>
            <if test="expireDateFlag != null and expireDateFlag != ''">expire_date_flag,</if>
            <if test="recptDateFlag != null and recptDateFlag != ''">recpt_date_flag,</if>
            <if test="vendorFlag != null and vendorFlag != ''">vendor_flag,</if>
            <if test="clientFlag != null and clientFlag != ''">client_flag,</if>
            <if test="coCodeFlag != null and coCodeFlag != ''">co_code_flag,</if>
            <if test="poCodeFlag != null and poCodeFlag != ''">po_code_flag,</if>
            <if test="workorderFlag != null and workorderFlag != ''">workorder_flag,</if>
            <if test="taskFlag != null and taskFlag != ''">task_flag,</if>
            <if test="workstationFlag != null and workstationFlag != ''">workstation_flag,</if>
            <if test="toolFlag != null and toolFlag != ''">tool_flag,</if>
            <if test="moldFlag != null and moldFlag != ''">mold_flag,</if>
            <if test="lotNumberFlag != null and lotNumberFlag != ''">lot_number_flag,</if>
            <if test="qualityStatusFlag != null and qualityStatusFlag != ''">quality_status_flag,</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemId != null">#{itemId},</if>
            <if test="produceDateFlag != null and produceDateFlag != ''">#{produceDateFlag},</if>
            <if test="expireDateFlag != null and expireDateFlag != ''">#{expireDateFlag},</if>
            <if test="recptDateFlag != null and recptDateFlag != ''">#{recptDateFlag},</if>
            <if test="vendorFlag != null and vendorFlag != ''">#{vendorFlag},</if>
            <if test="clientFlag != null and clientFlag != ''">#{clientFlag},</if>
            <if test="coCodeFlag != null and coCodeFlag != ''">#{coCodeFlag},</if>
            <if test="poCodeFlag != null and poCodeFlag != ''">#{poCodeFlag},</if>
            <if test="workorderFlag != null and workorderFlag != ''">#{workorderFlag},</if>
            <if test="taskFlag != null and taskFlag != ''">#{taskFlag},</if>
            <if test="workstationFlag != null and workstationFlag != ''">#{workstationFlag},</if>
            <if test="toolFlag != null and toolFlag != ''">#{toolFlag},</if>
            <if test="moldFlag != null and moldFlag != ''">#{moldFlag},</if>
            <if test="lotNumberFlag != null and lotNumberFlag != ''">#{lotNumberFlag},</if>
            <if test="qualityStatusFlag != null and qualityStatusFlag != ''">#{qualityStatusFlag},</if>
            <if test="enableFlag != null and enableFlag != ''">#{enableFlag},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <!-- 根据ID修改物料批次属性配置：只更新非 null 字段；create_by / create_time / del_flag 不参与修改 -->
    <update id="updateById" parameterType="com.elevn.mes.md.entity.MdItemBatchConfig">
        update md_item_batch_config
        <set>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="produceDateFlag != null and produceDateFlag != ''">produce_date_flag = #{produceDateFlag},</if>
            <if test="expireDateFlag != null and expireDateFlag != ''">expire_date_flag = #{expireDateFlag},</if>
            <if test="recptDateFlag != null and recptDateFlag != ''">recpt_date_flag = #{recptDateFlag},</if>
            <if test="vendorFlag != null and vendorFlag != ''">vendor_flag = #{vendorFlag},</if>
            <if test="clientFlag != null and clientFlag != ''">client_flag = #{clientFlag},</if>
            <if test="coCodeFlag != null and coCodeFlag != ''">co_code_flag = #{coCodeFlag},</if>
            <if test="poCodeFlag != null and poCodeFlag != ''">po_code_flag = #{poCodeFlag},</if>
            <if test="workorderFlag != null and workorderFlag != ''">workorder_flag = #{workorderFlag},</if>
            <if test="taskFlag != null and taskFlag != ''">task_flag = #{taskFlag},</if>
            <if test="workstationFlag != null and workstationFlag != ''">workstation_flag = #{workstationFlag},</if>
            <if test="toolFlag != null and toolFlag != ''">tool_flag = #{toolFlag},</if>
            <if test="moldFlag != null and moldFlag != ''">mold_flag = #{moldFlag},</if>
            <if test="lotNumberFlag != null and lotNumberFlag != ''">lot_number_flag = #{lotNumberFlag},</if>
            <if test="qualityStatusFlag != null and qualityStatusFlag != ''">quality_status_flag = #{qualityStatusFlag},</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag = #{enableFlag},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where config_id = #{configId}
        and del_flag = '0'
    </update>

    <!-- 根据ID删除物料批次属性配置：逻辑删除，把 del_flag 置为 1，记录仍然留在库里 -->
    <delete id="deleteById">
        update md_item_batch_config set del_flag = '1'
        where config_id = #{id}
        and del_flag = '0'
    </delete>

    <!-- 批量删除：同样走逻辑删除，一次把多个 id 的 del_flag 置为 1 -->
    <update id="deleteBatch">
        update md_item_batch_config set del_flag = '1'
        where del_flag = '0'
          and config_id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>

    <!-- 多条件查询物料批次属性配置：条件为空则该字段不参与过滤；始终只查未删除的数据
         编码 / 名称类字段走模糊查询，状态标志、ID 类字段走精确匹配。 -->
    <select id="selectByCondition" parameterType="com.elevn.mes.md.entity.MdItemBatchConfig" resultMap="MdItemBatchConfigResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_item_batch_config
        <where>
            del_flag = '0'
            <if test="configId != null">and config_id = #{configId}</if>
            <if test="itemId != null">and item_id = #{itemId}</if>
            <if test="produceDateFlag != null and produceDateFlag != ''">and produce_date_flag = #{produceDateFlag}</if>
            <if test="expireDateFlag != null and expireDateFlag != ''">and expire_date_flag = #{expireDateFlag}</if>
            <if test="recptDateFlag != null and recptDateFlag != ''">and recpt_date_flag = #{recptDateFlag}</if>
            <if test="vendorFlag != null and vendorFlag != ''">and vendor_flag = #{vendorFlag}</if>
            <if test="clientFlag != null and clientFlag != ''">and client_flag = #{clientFlag}</if>
            <if test="coCodeFlag != null and coCodeFlag != ''">and co_code_flag = #{coCodeFlag}</if>
            <if test="poCodeFlag != null and poCodeFlag != ''">and po_code_flag = #{poCodeFlag}</if>
            <if test="workorderFlag != null and workorderFlag != ''">and workorder_flag = #{workorderFlag}</if>
            <if test="taskFlag != null and taskFlag != ''">and task_flag = #{taskFlag}</if>
            <if test="workstationFlag != null and workstationFlag != ''">and workstation_flag = #{workstationFlag}</if>
            <if test="toolFlag != null and toolFlag != ''">and tool_flag = #{toolFlag}</if>
            <if test="moldFlag != null and moldFlag != ''">and mold_flag = #{moldFlag}</if>
            <if test="lotNumberFlag != null and lotNumberFlag != ''">and lot_number_flag = #{lotNumberFlag}</if>
            <if test="qualityStatusFlag != null and qualityStatusFlag != ''">and quality_status_flag = #{qualityStatusFlag}</if>
            <if test="enableFlag != null and enableFlag != ''">and enable_flag = #{enableFlag}</if>
            <if test="remark != null and remark != ''">and remark like concat('%', #{remark}, '%')</if>
        </where>
        order by config_id asc
    </select>

    <!-- 按所属ID查询（一对一，只取一条） -->
    <select id="selectByItemId" resultMap="MdItemBatchConfigResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_item_batch_config
        <where>
            del_flag = '0'
            and item_id = #{itemId}
        </where>
        limit 1
    </select>

    <!-- 根据ID查询单条
         这里必须包 <where>：MyBatis 的 <where> 会自动处理首个 and 的去留，
         不包的话 from 后面直接跟条件、没有 where 关键字，MySQL 直接报语法错误。 -->
    <select id="selectById" resultMap="MdItemBatchConfigResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_item_batch_config
        <where>
            del_flag = '0'
            and config_id = #{id}
        </where>
    </select>

</mapper>
