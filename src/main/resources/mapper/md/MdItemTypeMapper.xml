<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    物料产品分类


    说明：本文件是手写 SQL。逻辑删除需要自己在 SQL 里写 del_flag，
          每条查询都要带 del_flag = '0'，否则会把已删除的数据查出来。
-->
<mapper namespace="com.elevn.mes.md.mapper.MdItemTypeMapper">

    <!-- md_item_type 表字段与实体属性的映射 -->
    <resultMap id="MdItemTypeResultMap" type="com.elevn.mes.md.entity.MdItemType">
        <id column="item_type_id" property="itemTypeId"/>
        <result column="item_type_code" property="itemTypeCode"/>
        <result column="item_type_name" property="itemTypeName"/>
        <result column="parent_type_id" property="parentTypeId"/>
        <result column="ancestors" property="ancestors"/>
        <result column="item_or_product" property="itemOrProduct"/>
        <result column="order_num" property="orderNum"/>
        <result column="enable_flag" property="enableFlag"/>
        <result column="del_flag" property="delFlag"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 公共字段列表，避免每句 SQL 重复罗列 -->
    <sql id="Base_Column_List">
        item_type_id, item_type_code, item_type_name, parent_type_id, ancestors,
        item_or_product, order_num, enable_flag, del_flag, remark,
        create_by, create_time, update_by, update_time
    </sql>

    <!-- 新增物料产品分类：字段为 null 时不写入，交给数据库默认值 -->
    <insert id="insert" parameterType="com.elevn.mes.md.entity.MdItemType" useGeneratedKeys="true" keyProperty="itemTypeId">
        insert into md_item_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemTypeCode != null and itemTypeCode != ''">item_type_code,</if>
            <if test="itemTypeName != null and itemTypeName != ''">item_type_name,</if>
            <if test="parentTypeId != null">parent_type_id,</if>
            <if test="ancestors != null and ancestors != ''">ancestors,</if>
            <if test="itemOrProduct != null and itemOrProduct != ''">item_or_product,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemTypeCode != null and itemTypeCode != ''">#{itemTypeCode},</if>
            <if test="itemTypeName != null and itemTypeName != ''">#{itemTypeName},</if>
            <if test="parentTypeId != null">#{parentTypeId},</if>
            <if test="ancestors != null and ancestors != ''">#{ancestors},</if>
            <if test="itemOrProduct != null and itemOrProduct != ''">#{itemOrProduct},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="enableFlag != null and enableFlag != ''">#{enableFlag},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <!-- 根据ID修改物料产品分类：只更新非 null 字段；create_by / create_time / del_flag 不参与修改 -->
    <update id="updateById" parameterType="com.elevn.mes.md.entity.MdItemType">
        update md_item_type
        <set>
            <if test="itemTypeCode != null and itemTypeCode != ''">item_type_code = #{itemTypeCode},</if>
            <if test="itemTypeName != null and itemTypeName != ''">item_type_name = #{itemTypeName},</if>
            <if test="parentTypeId != null">parent_type_id = #{parentTypeId},</if>
            <if test="ancestors != null and ancestors != ''">ancestors = #{ancestors},</if>
            <if test="itemOrProduct != null and itemOrProduct != ''">item_or_product = #{itemOrProduct},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag = #{enableFlag},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where item_type_id = #{itemTypeId}
        and del_flag = '0'
    </update>

    <!-- 根据ID删除物料产品分类：逻辑删除，把 del_flag 置为 1，记录仍然留在库里 -->
    <delete id="deleteById">
        update md_item_type set del_flag = '1'
        where item_type_id = #{id}
        and del_flag = '0'
    </delete>

    <!-- 批量删除：同样走逻辑删除，一次把多个 id 的 del_flag 置为 1 -->
    <update id="deleteBatch">
        update md_item_type set del_flag = '1'
        where del_flag = '0'
          and item_type_id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>

    <!-- 多条件查询物料产品分类：条件为空则该字段不参与过滤；始终只查未删除的数据
         编码 / 名称类字段走模糊查询，状态标志、ID 类字段走精确匹配。 -->
    <select id="selectByCondition" parameterType="com.elevn.mes.md.entity.MdItemType" resultMap="MdItemTypeResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_item_type
        <where>
            del_flag = '0'
            <if test="itemTypeId != null">and item_type_id = #{itemTypeId}</if>
            <if test="itemTypeCode != null and itemTypeCode != ''">and item_type_code like concat('%', #{itemTypeCode}, '%')</if>
            <if test="itemTypeName != null and itemTypeName != ''">and item_type_name like concat('%', #{itemTypeName}, '%')</if>
            <if test="parentTypeId != null">and parent_type_id = #{parentTypeId}</if>
            <if test="ancestors != null and ancestors != ''">and ancestors = #{ancestors}</if>
            <if test="itemOrProduct != null and itemOrProduct != ''">and item_or_product = #{itemOrProduct}</if>
            <if test="orderNum != null">and order_num = #{orderNum}</if>
            <if test="enableFlag != null and enableFlag != ''">and enable_flag = #{enableFlag}</if>
            <if test="remark != null and remark != ''">and remark like concat('%', #{remark}, '%')</if>
        </where>
        order by order_num asc, item_type_id asc
    </select>

    <!-- 根据编码查询（校验编码重复用） -->
    <select id="selectByItemTypeCode" resultMap="MdItemTypeResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_item_type
        <where>
            del_flag = '0'
            and item_type_code = #{itemTypeCode}
        </where>
        limit 1
    </select>

    <!-- 根据ID查询单条
         这里必须包 <where>：MyBatis 的 <where> 会自动处理首个 and 的去留，
         不包的话 from 后面直接跟条件、没有 where 关键字，MySQL 直接报语法错误。 -->
    <select id="selectById" resultMap="MdItemTypeResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_item_type
        <where>
            del_flag = '0'
            and item_type_id = #{id}
        </where>
    </select>
    <select id="selectByParentTypeIdAndType"  resultMap="MdItemTypeResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_item_type
        <where>
            del_flag = '0'
            <if test="parentTypeId != null">
                and parent_type_id = #{parentTypeId}
            </if>
            <if test="type != null and type != ''">
                and item_or_product = #{type}
            </if>
        </where>
    </select>
    <select id="selectByParentId"  resultMap="MdItemTypeResultMap">
    select
    <include refid="Base_Column_List"/>
    from md_item_type
       where del_flag = '0'
            and parent_type_id = #{parentTypeId}
    </select>
    <select id="selectCountByParentId" resultType="java.lang.Integer">
        select count(1) from md_item_type
        where del_flag = '0'
          and parent_type_id = #{parentTypeId}
    </select>
</mapper>
