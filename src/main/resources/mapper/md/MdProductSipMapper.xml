<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    产品SIP


    说明：本文件是手写 SQL。逻辑删除需要自己在 SQL 里写 del_flag，
          每条查询都要带 del_flag = '0'，否则会把已删除的数据查出来。
-->
<mapper namespace="com.elevn.mes.md.mapper.MdProductSipMapper">

    <!-- md_product_sip 表字段与实体属性的映射 -->
    <resultMap id="MdProductSipResultMap" type="com.elevn.mes.md.entity.MdProductSip">
        <id column="sip_id" property="sipId"/>
        <result column="item_id" property="itemId"/>
        <result column="order_num" property="orderNum"/>
        <result column="process_id" property="processId"/>
        <result column="process_code" property="processCode"/>
        <result column="process_name" property="processName"/>
        <result column="sip_title" property="sipTitle"/>
        <result column="sip_description" property="sipDescription"/>
        <result column="sip_url" property="sipUrl"/>
        <result column="enable_flag" property="enableFlag"/>
        <result column="del_flag" property="delFlag"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 公共字段列表，避免每句 SQL 重复罗列 -->
    <sql id="Base_Column_List">
        sip_id, item_id, order_num, process_id, process_code,
        process_name, sip_title, sip_description, sip_url, enable_flag, del_flag,
        remark, create_by, create_time, update_by, update_time
    </sql>

    <!-- 新增产品SIP：字段为 null 时不写入，交给数据库默认值 -->
    <insert id="insert" parameterType="com.elevn.mes.md.entity.MdProductSip" useGeneratedKeys="true" keyProperty="sipId">
        insert into md_product_sip
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemId != null">item_id,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="processId != null">process_id,</if>
            <if test="processCode != null and processCode != ''">process_code,</if>
            <if test="processName != null and processName != ''">process_name,</if>
            <if test="sipTitle != null and sipTitle != ''">sip_title,</if>
            <if test="sipDescription != null and sipDescription != ''">sip_description,</if>
            <if test="sipUrl != null and sipUrl != ''">sip_url,</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemId != null">#{itemId},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="processId != null">#{processId},</if>
            <if test="processCode != null and processCode != ''">#{processCode},</if>
            <if test="processName != null and processName != ''">#{processName},</if>
            <if test="sipTitle != null and sipTitle != ''">#{sipTitle},</if>
            <if test="sipDescription != null and sipDescription != ''">#{sipDescription},</if>
            <if test="sipUrl != null and sipUrl != ''">#{sipUrl},</if>
            <if test="enableFlag != null and enableFlag != ''">#{enableFlag},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <!-- 根据ID修改产品SIP：只更新非 null 字段；create_by / create_time / del_flag 不参与修改 -->
    <update id="updateById" parameterType="com.elevn.mes.md.entity.MdProductSip">
        update md_product_sip
        <set>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="processId != null">process_id = #{processId},</if>
            <if test="processCode != null and processCode != ''">process_code = #{processCode},</if>
            <if test="processName != null and processName != ''">process_name = #{processName},</if>
            <if test="sipTitle != null and sipTitle != ''">sip_title = #{sipTitle},</if>
            <if test="sipDescription != null and sipDescription != ''">sip_description = #{sipDescription},</if>
            <if test="sipUrl != null and sipUrl != ''">sip_url = #{sipUrl},</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag = #{enableFlag},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where sip_id = #{sipId}
        and del_flag = '0'
    </update>

    <!-- 根据ID删除产品SIP：逻辑删除，把 del_flag 置为 1，记录仍然留在库里 -->
    <delete id="deleteById">
        update md_product_sip set del_flag = '1'
        where sip_id = #{id}
        and del_flag = '0'
    </delete>

    <!-- 批量删除：同样走逻辑删除，一次把多个 id 的 del_flag 置为 1 -->
    <update id="deleteBatch">
        update md_product_sip set del_flag = '1'
        where del_flag = '0'
          and sip_id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>

    <!-- 多条件查询产品SIP：条件为空则该字段不参与过滤；始终只查未删除的数据
         编码 / 名称类字段走模糊查询，状态标志、ID 类字段走精确匹配。 -->
    <select id="selectByCondition" parameterType="com.elevn.mes.md.entity.MdProductSip" resultMap="MdProductSipResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_product_sip
        <where>
            del_flag = '0'
            <if test="sipId != null">and sip_id = #{sipId}</if>
            <if test="itemId != null">and item_id = #{itemId}</if>
            <if test="orderNum != null">and order_num = #{orderNum}</if>
            <if test="processId != null">and process_id = #{processId}</if>
            <if test="processCode != null and processCode != ''">and process_code like concat('%', #{processCode}, '%')</if>
            <if test="processName != null and processName != ''">and process_name like concat('%', #{processName}, '%')</if>
            <if test="sipTitle != null and sipTitle != ''">and sip_title like concat('%', #{sipTitle}, '%')</if>
            <if test="sipDescription != null and sipDescription != ''">and sip_description like concat('%', #{sipDescription}, '%')</if>
            <if test="sipUrl != null and sipUrl != ''">and sip_url = #{sipUrl}</if>
            <if test="enableFlag != null and enableFlag != ''">and enable_flag = #{enableFlag}</if>
            <if test="remark != null and remark != ''">and remark like concat('%', #{remark}, '%')</if>
        </where>
        order by order_num asc, sip_id asc
    </select>

    <!-- 按所属ID查询子表列表 -->
    <select id="selectByItemId" resultMap="MdProductSipResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_product_sip
        <where>
            del_flag = '0'
            and item_id = #{itemId}
        </where>
        order by order_num asc, sip_id asc
    </select>

    <!-- 根据ID查询单条
         这里必须包 <where>：MyBatis 的 <where> 会自动处理首个 and 的去留，
         不包的话 from 后面直接跟条件、没有 where 关键字，MySQL 直接报语法错误。 -->
    <select id="selectById" resultMap="MdProductSipResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_product_sip
        <where>
            del_flag = '0'
            and sip_id = #{id}
        </where>
    </select>

</mapper>
