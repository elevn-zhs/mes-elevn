<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    计量单位


    说明：本文件是手写 SQL。逻辑删除需要自己在 SQL 里写 del_flag，
          每条查询都要带 del_flag = '0'，否则会把已删除的数据查出来。
-->
<mapper namespace="com.elevn.mes.md.mapper.MdUnitMeasureMapper">

    <!-- md_unit_measure 表字段与实体属性的映射 -->
    <resultMap id="MdUnitMeasureResultMap" type="com.elevn.mes.md.entity.MdUnitMeasure">
        <id column="measure_id" property="measureId"/>
        <result column="measure_code" property="measureCode"/>
        <result column="measure_name" property="measureName"/>
        <result column="primary_flag" property="primaryFlag"/>
        <result column="primary_id" property="primaryId"/>
        <result column="change_rate" property="changeRate"/>
        <result column="enable_flag" property="enableFlag"/>
        <result column="del_flag" property="delFlag"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 公共字段列表，避免每句 SQL 重复罗列 -->
    <sql id="Base_Column_List">
        measure_id, measure_code, measure_name, primary_flag, primary_id,
        change_rate, enable_flag, del_flag, remark, create_by,
        create_time, update_by, update_time
    </sql>

    <!-- 新增计量单位：字段为 null 时不写入，交给数据库默认值 -->
    <insert id="insert" parameterType="com.elevn.mes.md.entity.MdUnitMeasure" useGeneratedKeys="true" keyProperty="measureId">
        insert into md_unit_measure
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="measureCode != null and measureCode != ''">measure_code,</if>
            <if test="measureName != null and measureName != ''">measure_name,</if>
            <if test="primaryFlag != null and primaryFlag != ''">primary_flag,</if>
            <if test="primaryId != null">primary_id,</if>
            <if test="changeRate != null">change_rate,</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="measureCode != null and measureCode != ''">#{measureCode},</if>
            <if test="measureName != null and measureName != ''">#{measureName},</if>
            <if test="primaryFlag != null and primaryFlag != ''">#{primaryFlag},</if>
            <if test="primaryId != null">#{primaryId},</if>
            <if test="changeRate != null">#{changeRate},</if>
            <if test="enableFlag != null and enableFlag != ''">#{enableFlag},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <!-- 根据ID修改计量单位：只更新非 null 字段；create_by / create_time / del_flag 不参与修改 -->
    <update id="updateById" parameterType="com.elevn.mes.md.entity.MdUnitMeasure">
        update md_unit_measure
        <set>
            <if test="measureCode != null and measureCode != ''">measure_code = #{measureCode},</if>
            <if test="measureName != null and measureName != ''">measure_name = #{measureName},</if>
            <if test="primaryFlag != null and primaryFlag != ''">primary_flag = #{primaryFlag},</if>
            <if test="primaryId != null">primary_id = #{primaryId},</if>
            <if test="changeRate != null">change_rate = #{changeRate},</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag = #{enableFlag},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where measure_id = #{measureId}
        and del_flag = '0'
    </update>

    <!-- 根据ID删除计量单位：逻辑删除，把 del_flag 置为 1，记录仍然留在库里 -->
    <delete id="deleteById">
        update md_unit_measure set del_flag = '1'
        where measure_id = #{id}
        and del_flag = '0'
    </delete>

    <!-- 批量删除：同样走逻辑删除，一次把多个 id 的 del_flag 置为 1 -->
    <update id="deleteBatch">
        update md_unit_measure set del_flag = '1'
        where del_flag = '0'
          and measure_id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>

    <!-- 多条件查询计量单位：条件为空则该字段不参与过滤；始终只查未删除的数据
         编码 / 名称类字段走模糊查询，状态标志、ID 类字段走精确匹配。 -->
    <select id="selectByCondition" parameterType="com.elevn.mes.md.entity.MdUnitMeasure" resultMap="MdUnitMeasureResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_unit_measure
        <where>
            del_flag = '0'
            <if test="measureId != null">and measure_id = #{measureId}</if>
            <if test="measureCode != null and measureCode != ''">and measure_code like concat('%', #{measureCode}, '%')</if>
            <if test="measureName != null and measureName != ''">and measure_name like concat('%', #{measureName}, '%')</if>
            <if test="primaryFlag != null and primaryFlag != ''">and primary_flag = #{primaryFlag}</if>
            <if test="primaryId != null">and primary_id = #{primaryId}</if>
            <if test="enableFlag != null and enableFlag != ''">and enable_flag = #{enableFlag}</if>
            <if test="remark != null and remark != ''">and remark like concat('%', #{remark}, '%')</if>
        </where>
        order by measure_id asc
    </select>

    <!-- 根据编码查询（校验编码重复用） -->
    <select id="selectByMeasureCode" resultMap="MdUnitMeasureResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_unit_measure
        <where>
            del_flag = '0'
            and measure_code = #{measureCode}
        </where>
        limit 1
    </select>

    <!-- 根据ID查询单条
         这里必须包 <where>：MyBatis 的 <where> 会自动处理首个 and 的去留，
         不包的话 from 后面直接跟条件、没有 where 关键字，MySQL 直接报语法错误。 -->
    <select id="selectById" resultMap="MdUnitMeasureResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_unit_measure
        <where>
            del_flag = '0'
            and measure_id = #{id}
        </where>
    </select>

</mapper>
