<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    物料替代品


    说明：本文件是手写 SQL。逻辑删除需要自己在 SQL 里写 del_flag，
          每条查询都要带 del_flag = '0'，否则会把已删除的数据查出来。
-->
<mapper namespace="com.elevn.mes.md.mapper.MdItemSubstituteMapper">

    <!-- md_item_substitute 表字段与实体属性的映射 -->
    <resultMap id="MdItemSubstituteResultMap" type="com.elevn.mes.md.entity.MdItemSubstitute">
        <id column="substitute_id" property="substituteId"/>
        <result column="item_id" property="itemId"/>
        <result column="item_code" property="itemCode"/>
        <result column="item_name" property="itemName"/>
        <result column="sub_item_id" property="subItemId"/>
        <result column="sub_item_code" property="subItemCode"/>
        <result column="sub_item_name" property="subItemName"/>
        <result column="sub_item_spec" property="subItemSpec"/>
        <result column="unit_of_measure" property="unitOfMeasure"/>
        <result column="substitute_type" property="substituteType"/>
        <result column="substitute_ratio" property="substituteRatio"/>
        <result column="priority" property="priority"/>
        <result column="effective_date" property="effectiveDate"/>
        <result column="expire_date" property="expireDate"/>
        <result column="enable_flag" property="enableFlag"/>
        <result column="del_flag" property="delFlag"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 公共字段列表，避免每句 SQL 重复罗列 -->
    <sql id="Base_Column_List">
        substitute_id, item_id, item_code, item_name,
        sub_item_id, sub_item_code, sub_item_name, sub_item_spec,
        unit_of_measure, substitute_type, substitute_ratio, priority,
        effective_date, expire_date, enable_flag, del_flag,
        remark, create_by, create_time, update_by,
        update_time
    </sql>

    <!-- 新增物料替代品：字段为 null 时不写入，交给数据库默认值 -->
    <insert id="insert" parameterType="com.elevn.mes.md.entity.MdItemSubstitute" useGeneratedKeys="true" keyProperty="substituteId">
        insert into md_item_substitute
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="substituteId != null">substitute_id,</if>
            <if test="itemId != null">item_id,</if>
            <if test="itemCode != null and itemCode != ''">item_code,</if>
            <if test="itemName != null and itemName != ''">item_name,</if>
            <if test="subItemId != null">sub_item_id,</if>
            <if test="subItemCode != null and subItemCode != ''">sub_item_code,</if>
            <if test="subItemName != null and subItemName != ''">sub_item_name,</if>
            <if test="subItemSpec != null and subItemSpec != ''">sub_item_spec,</if>
            <if test="unitOfMeasure != null and unitOfMeasure != ''">unit_of_measure,</if>
            <if test="substituteType != null and substituteType != ''">substitute_type,</if>
            <if test="substituteRatio != null">substitute_ratio,</if>
            <if test="priority != null">priority,</if>
            <if test="effectiveDate != null">effective_date,</if>
            <if test="expireDate != null">expire_date,</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="substituteId != null">#{substituteId},</if>
            <if test="itemId != null">#{itemId},</if>
            <if test="itemCode != null and itemCode != ''">#{itemCode},</if>
            <if test="itemName != null and itemName != ''">#{itemName},</if>
            <if test="subItemId != null">#{subItemId},</if>
            <if test="subItemCode != null and subItemCode != ''">#{subItemCode},</if>
            <if test="subItemName != null and subItemName != ''">#{subItemName},</if>
            <if test="subItemSpec != null and subItemSpec != ''">#{subItemSpec},</if>
            <if test="unitOfMeasure != null and unitOfMeasure != ''">#{unitOfMeasure},</if>
            <if test="substituteType != null and substituteType != ''">#{substituteType},</if>
            <if test="substituteRatio != null">#{substituteRatio},</if>
            <if test="priority != null">#{priority},</if>
            <if test="effectiveDate != null">#{effectiveDate},</if>
            <if test="expireDate != null">#{expireDate},</if>
            <if test="enableFlag != null and enableFlag != ''">#{enableFlag},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <!-- 根据ID修改物料替代品：只更新非 null 字段；create_by / create_time / del_flag 不参与修改 -->
    <update id="updateById" parameterType="com.elevn.mes.md.entity.MdItemSubstitute">
        update md_item_substitute
        <set>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="itemCode != null and itemCode != ''">item_code = #{itemCode},</if>
            <if test="itemName != null and itemName != ''">item_name = #{itemName},</if>
            <if test="subItemId != null">sub_item_id = #{subItemId},</if>
            <if test="subItemCode != null and subItemCode != ''">sub_item_code = #{subItemCode},</if>
            <if test="subItemName != null and subItemName != ''">sub_item_name = #{subItemName},</if>
            <if test="subItemSpec != null and subItemSpec != ''">sub_item_spec = #{subItemSpec},</if>
            <if test="unitOfMeasure != null and unitOfMeasure != ''">unit_of_measure = #{unitOfMeasure},</if>
            <if test="substituteType != null and substituteType != ''">substitute_type = #{substituteType},</if>
            <if test="substituteRatio != null">substitute_ratio = #{substituteRatio},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="effectiveDate != null">effective_date = #{effectiveDate},</if>
            <if test="expireDate != null">expire_date = #{expireDate},</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag = #{enableFlag},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where substitute_id = #{substituteId}
        and del_flag = '0'
    </update>

    <!-- 根据ID删除物料替代品：逻辑删除，把 del_flag 置为 1，记录仍然留在库里 -->
    <delete id="deleteById">
        update md_item_substitute set del_flag = '1'
        where substitute_id = #{id}
        and del_flag = '0'
    </delete>

    <!-- 批量删除：同样走逻辑删除，一次把多个 id 的 del_flag 置为 1 -->
    <update id="deleteBatch">
        update md_item_substitute set del_flag = '1'
        where del_flag = '0'
          and substitute_id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>

    <!-- 多条件查询物料替代品：条件为空则该字段不参与过滤；始终只查未删除的数据
         编码 / 名称类字段走模糊查询，状态标志、ID 类字段走精确匹配。 -->
    <select id="selectByCondition" parameterType="com.elevn.mes.md.entity.MdItemSubstitute" resultMap="MdItemSubstituteResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_item_substitute
        <where>
            del_flag = '0'
            <if test="substituteId != null">and substitute_id = #{substituteId}</if>
            <if test="itemId != null">and item_id = #{itemId}</if>
            <if test="itemCode != null and itemCode != ''">and item_code like concat('%', #{itemCode}, '%')</if>
            <if test="itemName != null and itemName != ''">and item_name like concat('%', #{itemName}, '%')</if>
            <if test="subItemId != null">and sub_item_id = #{subItemId}</if>
            <if test="subItemCode != null and subItemCode != ''">and sub_item_code like concat('%', #{subItemCode}, '%')</if>
            <if test="subItemName != null and subItemName != ''">and sub_item_name like concat('%', #{subItemName}, '%')</if>
            <if test="subItemSpec != null and subItemSpec != ''">and sub_item_spec like concat('%', #{subItemSpec}, '%')</if>
            <if test="unitOfMeasure != null and unitOfMeasure != ''">and unit_of_measure = #{unitOfMeasure}</if>
            <if test="substituteType != null and substituteType != ''">and substitute_type = #{substituteType}</if>
            <if test="substituteRatio != null">and substitute_ratio = #{substituteRatio}</if>
            <if test="priority != null">and priority = #{priority}</if>
            <if test="enableFlag != null and enableFlag != ''">and enable_flag = #{enableFlag}</if>
            <if test="remark != null and remark != ''">and remark like concat('%', #{remark}, '%')</if>
        </where>
        order by substitute_id asc
    </select>

    <!-- 按所属物料ID查询子表列表 -->
    <select id="selectByItemId" resultMap="MdItemSubstituteResultMap">
        select
        <include refid="Base_Column_List"/>
        from (
            select
            <include refid="Base_Column_List"/>
            from md_item_substitute
            where del_flag = '0' and item_id = #{itemId}
            union all
            select
                s.substitute_id,
                s.sub_item_id as item_id, s.sub_item_code as item_code, s.sub_item_name as item_name,
                s.item_id as sub_item_id, s.item_code as sub_item_code, s.item_name as sub_item_name,
                i.specification as sub_item_spec, i.unit_of_measure as unit_of_measure,
                s.substitute_type, s.substitute_ratio, s.priority, s.effective_date, s.expire_date,
                s.enable_flag, s.del_flag, s.remark, s.create_by, s.create_time, s.update_by, s.update_time
            from md_item_substitute s
            join md_item i on i.item_id = s.item_id
            where s.del_flag = '0' and s.sub_item_id = #{itemId} and s.substitute_type = 'TWO_WAY'
        ) t
        order by t.priority asc, t.substitute_id asc
    </select>

    <!-- 根据ID查询单条
         这里必须包 <where>：MyBatis 的 <where> 会自动处理首个 and 的去留，
         不包的话 from 后面直接跟条件、没有 where 关键字，MySQL 直接报语法错误。 -->
    <select id="selectById" resultMap="MdItemSubstituteResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_item_substitute
        <where>
            del_flag = '0'
            and substitute_id = #{id}
        </where>
    </select>

    <!-- 按业务唯一键查重
         唯一约束 uk(item_id, sub_item_id)：同一个主物料下不允许出现同一个目标物料。
         新增时用它查重；修改时在 Service 层比较主键排除自身（这里不加 excludeId 参数，
         避免 XML 里出现「同一个值两种用法」的歧义）。 -->
    <select id="selectByUniqueKey" resultMap="MdItemSubstituteResultMap">
        select
        <include refid="Base_Column_List"/>
        from md_item_substitute
        <where>
            del_flag = '0'
            and item_id = #{itemId}
            and sub_item_id = #{targetId}
        </where>
        limit 1
    </select>

</mapper>
