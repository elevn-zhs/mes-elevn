<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.elevn.mes.sys.mapper.SysLogMapper">

    <!-- sys_log 表字段与实体属性的映射 -->
    <resultMap id="SysLogResultMap" type="com.elevn.mes.sys.entity.SysLog">
        <id column="log_id" property="logId"/>
        <result column="log_type" property="logType"/>
        <result column="title" property="title"/>
        <result column="business_type" property="businessType"/>
        <result column="oper_name" property="operName"/>
        <result column="oper_nick" property="operNick"/>
        <result column="dept_name" property="deptName"/>
        <result column="method" property="method"/>
        <result column="request_method" property="requestMethod"/>
        <result column="oper_url" property="operUrl"/>
        <result column="oper_ip" property="operIp"/>
        <result column="oper_location" property="operLocation"/>
        <result column="oper_param" property="operParam"/>
        <result column="json_result" property="jsonResult"/>
        <result column="status" property="status"/>
        <result column="error_msg" property="errorMsg"/>
        <result column="operator_type" property="operatorType"/>
        <result column="user_agent" property="userAgent"/>
        <result column="browser" property="browser"/>
        <result column="os" property="os"/>
        <result column="cost_time" property="costTime"/>
        <result column="oper_time" property="operTime"/>
        <result column="del_flag" property="delFlag"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 公共字段列表，避免每句 SQL 重复罗列 -->
    <sql id="Base_Column_List">
        log_id, log_type, title, business_type, oper_name,
        oper_nick, dept_name, method, request_method, oper_url,
        oper_ip, oper_location, oper_param, json_result, status,
        error_msg, operator_type, user_agent, browser, os,
        cost_time, oper_time, del_flag, create_by, create_time,
        update_by, update_time, remark
    </sql>

    <!-- 新增操作日志：字段为 null 时不写入，交给数据库默认值 -->
    <insert id="insert" parameterType="com.elevn.mes.sys.entity.SysLog" useGeneratedKeys="true" keyProperty="logId">
        insert into sys_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="logType != null and logType != ''">log_type,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="businessType != null and businessType != ''">business_type,</if>
            <if test="operName != null and operName != ''">oper_name,</if>
            <if test="operNick != null and operNick != ''">oper_nick,</if>
            <if test="deptName != null and deptName != ''">dept_name,</if>
            <if test="method != null and method != ''">method,</if>
            <if test="requestMethod != null and requestMethod != ''">request_method,</if>
            <if test="operUrl != null and operUrl != ''">oper_url,</if>
            <if test="operIp != null and operIp != ''">oper_ip,</if>
            <if test="operLocation != null and operLocation != ''">oper_location,</if>
            <if test="operParam != null and operParam != ''">oper_param,</if>
            <if test="jsonResult != null and jsonResult != ''">json_result,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="errorMsg != null and errorMsg != ''">error_msg,</if>
            <if test="operatorType != null and operatorType != ''">operator_type,</if>
            <if test="userAgent != null and userAgent != ''">user_agent,</if>
            <if test="browser != null and browser != ''">browser,</if>
            <if test="os != null and os != ''">os,</if>
            <if test="costTime != null">cost_time,</if>
            <if test="operTime != null">oper_time,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="logType != null and logType != ''">#{logType},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="businessType != null and businessType != ''">#{businessType},</if>
            <if test="operName != null and operName != ''">#{operName},</if>
            <if test="operNick != null and operNick != ''">#{operNick},</if>
            <if test="deptName != null and deptName != ''">#{deptName},</if>
            <if test="method != null and method != ''">#{method},</if>
            <if test="requestMethod != null and requestMethod != ''">#{requestMethod},</if>
            <if test="operUrl != null and operUrl != ''">#{operUrl},</if>
            <if test="operIp != null and operIp != ''">#{operIp},</if>
            <if test="operLocation != null and operLocation != ''">#{operLocation},</if>
            <if test="operParam != null and operParam != ''">#{operParam},</if>
            <if test="jsonResult != null and jsonResult != ''">#{jsonResult},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="errorMsg != null and errorMsg != ''">#{errorMsg},</if>
            <if test="operatorType != null and operatorType != ''">#{operatorType},</if>
            <if test="userAgent != null and userAgent != ''">#{userAgent},</if>
            <if test="browser != null and browser != ''">#{browser},</if>
            <if test="os != null and os != ''">#{os},</if>
            <if test="costTime != null">#{costTime},</if>
            <if test="operTime != null">#{operTime},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <!-- 根据ID修改操作日志：只更新非 null 字段；create_by / create_time / del_flag 不参与修改 -->
    <update id="updateById" parameterType="com.elevn.mes.sys.entity.SysLog">
        update sys_log
        <set>
            <if test="logType != null and logType != ''">log_type = #{logType},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="businessType != null and businessType != ''">business_type = #{businessType},</if>
            <if test="operName != null and operName != ''">oper_name = #{operName},</if>
            <if test="operNick != null and operNick != ''">oper_nick = #{operNick},</if>
            <if test="deptName != null and deptName != ''">dept_name = #{deptName},</if>
            <if test="method != null and method != ''">method = #{method},</if>
            <if test="requestMethod != null and requestMethod != ''">request_method = #{requestMethod},</if>
            <if test="operUrl != null and operUrl != ''">oper_url = #{operUrl},</if>
            <if test="operIp != null and operIp != ''">oper_ip = #{operIp},</if>
            <if test="operLocation != null and operLocation != ''">oper_location = #{operLocation},</if>
            <if test="operParam != null and operParam != ''">oper_param = #{operParam},</if>
            <if test="jsonResult != null and jsonResult != ''">json_result = #{jsonResult},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="errorMsg != null and errorMsg != ''">error_msg = #{errorMsg},</if>
            <if test="operatorType != null and operatorType != ''">operator_type = #{operatorType},</if>
            <if test="userAgent != null and userAgent != ''">user_agent = #{userAgent},</if>
            <if test="browser != null and browser != ''">browser = #{browser},</if>
            <if test="os != null and os != ''">os = #{os},</if>
            <if test="costTime != null">cost_time = #{costTime},</if>
            <if test="operTime != null">oper_time = #{operTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
        </set>
        where log_id = #{logId}
        and del_flag = '0'
    </update>

    <!-- 根据ID删除操作日志：逻辑删除，把 del_flag 置为 1，记录仍然留在库里 -->
    <delete id="deleteById">
        update sys_log set del_flag = '1'
        where log_id = #{id}
        and del_flag = '0'
    </delete>

    <!-- 多条件查询操作日志：条件为空则该字段不参与过滤；始终只查未删除的数据 -->
    <select id="selectByCondition" parameterType="com.elevn.mes.sys.entity.SysLog" resultMap="SysLogResultMap">
        select
        <include refid="Base_Column_List"/>
        from sys_log
        <where>
            del_flag = '0'
            <if test="logId != null">and log_id = #{logId}</if>
            <if test="logType != null and logType != ''">and log_type = #{logType}</if>
            <if test="title != null and title != ''">and title like concat('%', #{title}, '%')</if>
            <if test="businessType != null and businessType != ''">and business_type = #{businessType}</if>
            <if test="operName != null and operName != ''">and oper_name like concat('%', #{operName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="operIp != null and operIp != ''">and oper_ip like concat('%', #{operIp}, '%')</if>
        </where>
        order by oper_time desc, log_id desc
    </select>
    <select id="selectById" resultMap="SysLogResultMap">
        select
        <include refid="Base_Column_List"/>
        from sys_log
        del_flag = '0'
        and log_id = #{logId}
    </select>

</mapper>
