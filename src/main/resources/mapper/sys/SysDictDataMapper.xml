<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.elevn.mes.sys.mapper.SysDictDataMapper">

    <!-- sys_dict_data 表字段与实体属性的映射 -->
    <resultMap id="SysDictDataResultMap" type="com.elevn.mes.sys.entity.SysDictData">
        <id column="dict_code" property="dictCode"/>
        <result column="dict_type" property="dictType"/>
        <result column="dict_label" property="dictLabel"/>
        <result column="dict_value" property="dictValue"/>
        <result column="dict_sort" property="dictSort"/>
        <result column="is_default" property="isDefault"/>
        <result column="list_class" property="listClass"/>
        <result column="css_class" property="cssClass"/>
        <result column="status" property="status"/>
        <result column="del_flag" property="delFlag"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 公共字段列表，避免每句 SQL 重复罗列 -->
    <sql id="Base_Column_List">
        dict_code, dict_type, dict_label, dict_value, dict_sort,
        is_default, list_class, css_class, status, del_flag,
        create_by, create_time, update_by, update_time, remark
    </sql>

    <!-- 新增字典数据：字段为 null 时不写入，交给数据库默认值 -->
    <insert id="insert" parameterType="com.elevn.mes.sys.entity.SysDictData" useGeneratedKeys="true" keyProperty="dictCode">
        insert into sys_dict_data
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dictType != null and dictType != ''">dict_type,</if>
            <if test="dictLabel != null and dictLabel != ''">dict_label,</if>
            <if test="dictValue != null and dictValue != ''">dict_value,</if>
            <if test="dictSort != null">dict_sort,</if>
            <if test="isDefault != null and isDefault != ''">is_default,</if>
            <if test="listClass != null and listClass != ''">list_class,</if>
            <if test="cssClass != null and cssClass != ''">css_class,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="dictType != null and dictType != ''">#{dictType},</if>
            <if test="dictLabel != null and dictLabel != ''">#{dictLabel},</if>
            <if test="dictValue != null and dictValue != ''">#{dictValue},</if>
            <if test="dictSort != null">#{dictSort},</if>
            <if test="isDefault != null and isDefault != ''">#{isDefault},</if>
            <if test="listClass != null and listClass != ''">#{listClass},</if>
            <if test="cssClass != null and cssClass != ''">#{cssClass},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <!-- 根据ID修改字典数据：只更新非 null 字段；create_by / create_time / del_flag 不参与修改 -->
    <update id="updateById" parameterType="com.elevn.mes.sys.entity.SysDictData">
        update sys_dict_data
        <set>
            <if test="dictType != null and dictType != ''">dict_type = #{dictType},</if>
            <if test="dictLabel != null and dictLabel != ''">dict_label = #{dictLabel},</if>
            <if test="dictValue != null and dictValue != ''">dict_value = #{dictValue},</if>
            <if test="dictSort != null">dict_sort = #{dictSort},</if>
            <if test="isDefault != null and isDefault != ''">is_default = #{isDefault},</if>
            <if test="listClass != null and listClass != ''">list_class = #{listClass},</if>
            <if test="cssClass != null and cssClass != ''">css_class = #{cssClass},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
        </set>
        where dict_code = #{dictCode}
        and del_flag = '0'
    </update>

    <!-- 根据ID删除字典数据：逻辑删除，把 del_flag 置为 1，记录仍然留在库里 -->
    <delete id="deleteById">
        update sys_dict_data set del_flag = '1'
        where dict_code = #{id}
        and del_flag = '0'
    </delete>

    <!-- 多条件查询字典数据：条件为空则该字段不参与过滤；始终只查未删除的数据 -->
    <select id="selectByCondition" parameterType="com.elevn.mes.sys.entity.SysDictData" resultMap="SysDictDataResultMap">
        select
        <include refid="Base_Column_List"/>
        from sys_dict_data
        <where>
            del_flag = '0'
            <if test="dictCode != null">and dict_code = #{dictCode}</if>
            <if test="dictType != null and dictType != ''">and dict_type = #{dictType}</if>
            <if test="dictLabel != null and dictLabel != ''">and dict_label like concat('%', #{dictLabel}, '%')</if>
            <if test="dictValue != null and dictValue != ''">and dict_value = #{dictValue}</if>
            <if test="isDefault != null and isDefault != ''">and is_default = #{isDefault}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by dict_sort asc
    </select>

    <!-- 根据字典类型查询全部条目 -->
    <select id="selectByDictType" resultMap="SysDictDataResultMap">
        select
        <include refid="Base_Column_List"/>
        from sys_dict_data
            where
            del_flag = '0'
            and status = '0'
            and dict_type = #{dictType}
        order by dict_sort asc
    </select>
    <select id="selectById" resultMap="SysDictDataResultMap">
        select
        <include refid="Base_Column_List"/>
        from sys_dict_data
        <where>
            del_flag = '0'
            and status = '0'
            and dict_code = #{id}
        </where>
    </select>

</mapper>
