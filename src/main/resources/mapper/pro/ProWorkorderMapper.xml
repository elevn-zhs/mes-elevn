<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    生产工单


    说明：本文件是手写 SQL。逻辑删除需要自己在 SQL 里写 del_flag，
          每条查询都要带 del_flag = '0'，否则会把已删除的数据查出来。
-->
<mapper namespace="com.elevn.mes.pro.mapper.ProWorkorderMapper">

    <!-- pro_workorder 表字段与实体属性的映射 -->
    <resultMap id="ProWorkorderResultMap" type="com.elevn.mes.pro.entity.ProWorkorder">
        <id column="workorder_id" property="workorderId"/>
        <result column="workorder_code" property="workorderCode"/>
        <result column="workorder_name" property="workorderName"/>
        <result column="workorder_type" property="workorderType"/>
        <result column="order_source" property="orderSource"/>
        <result column="source_code" property="sourceCode"/>
        <result column="product_id" property="productId"/>
        <result column="product_code" property="productCode"/>
        <result column="product_name" property="productName"/>
        <result column="product_spc" property="productSpc"/>
        <result column="unit_of_measure" property="unitOfMeasure"/>
        <result column="quantity" property="quantity"/>
        <result column="quantity_produced" property="quantityProduced"/>
        <result column="quantity_changed" property="quantityChanged"/>
        <result column="quantity_scheduled" property="quantityScheduled"/>
        <result column="client_id" property="clientId"/>
        <result column="client_code" property="clientCode"/>
        <result column="client_name" property="clientName"/>
        <result column="vendor_id" property="vendorId"/>
        <result column="vendor_code" property="vendorCode"/>
        <result column="vendor_name" property="vendorName"/>
        <result column="batch_code" property="batchCode"/>
        <result column="request_date" property="requestDate"/>
        <result column="parent_id" property="parentId"/>
        <result column="ancestors" property="ancestors"/>
        <result column="cancel_date" property="cancelDate"/>
        <result column="finish_date" property="finishDate"/>
        <result column="status" property="status"/>
        <result column="del_flag" property="delFlag"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 公共字段列表，避免每句 SQL 重复罗列 -->
    <sql id="Base_Column_List">
        workorder_id, workorder_code, workorder_name, workorder_type, order_source,
        source_code, product_id, product_code, product_name, product_spc,
        unit_of_measure, quantity, quantity_produced, quantity_changed, quantity_scheduled,
        client_id, client_code, client_name, vendor_id, vendor_code,
        vendor_name, batch_code, request_date, parent_id, ancestors,
        cancel_date, finish_date, status, del_flag, remark,
        create_by, create_time, update_by, update_time
    </sql>

    <!-- 新增生产工单：字段为 null 时不写入，交给数据库默认值 -->
    <insert id="insert" parameterType="com.elevn.mes.pro.entity.ProWorkorder" useGeneratedKeys="true" keyProperty="workorderId">
        insert into pro_workorder
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="workorderCode != null and workorderCode != ''">workorder_code,</if>
            <if test="workorderName != null and workorderName != ''">workorder_name,</if>
            <if test="workorderType != null and workorderType != ''">workorder_type,</if>
            <if test="orderSource != null and orderSource != ''">order_source,</if>
            <if test="sourceCode != null and sourceCode != ''">source_code,</if>
            <if test="productId != null">product_id,</if>
            <if test="productCode != null and productCode != ''">product_code,</if>
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="productSpc != null and productSpc != ''">product_spc,</if>
            <if test="unitOfMeasure != null and unitOfMeasure != ''">unit_of_measure,</if>
            <if test="quantity != null">quantity,</if>
            <if test="quantityProduced != null">quantity_produced,</if>
            <if test="quantityChanged != null">quantity_changed,</if>
            <if test="quantityScheduled != null">quantity_scheduled,</if>
            <if test="clientId != null">client_id,</if>
            <if test="clientCode != null and clientCode != ''">client_code,</if>
            <if test="clientName != null and clientName != ''">client_name,</if>
            <if test="vendorId != null">vendor_id,</if>
            <if test="vendorCode != null and vendorCode != ''">vendor_code,</if>
            <if test="vendorName != null and vendorName != ''">vendor_name,</if>
            <if test="batchCode != null and batchCode != ''">batch_code,</if>
            <if test="requestDate != null">request_date,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="ancestors != null and ancestors != ''">ancestors,</if>
            <if test="cancelDate != null">cancel_date,</if>
            <if test="finishDate != null">finish_date,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="workorderCode != null and workorderCode != ''">#{workorderCode},</if>
            <if test="workorderName != null and workorderName != ''">#{workorderName},</if>
            <if test="workorderType != null and workorderType != ''">#{workorderType},</if>
            <if test="orderSource != null and orderSource != ''">#{orderSource},</if>
            <if test="sourceCode != null and sourceCode != ''">#{sourceCode},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productCode != null and productCode != ''">#{productCode},</if>
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="productSpc != null and productSpc != ''">#{productSpc},</if>
            <if test="unitOfMeasure != null and unitOfMeasure != ''">#{unitOfMeasure},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="quantityProduced != null">#{quantityProduced},</if>
            <if test="quantityChanged != null">#{quantityChanged},</if>
            <if test="quantityScheduled != null">#{quantityScheduled},</if>
            <if test="clientId != null">#{clientId},</if>
            <if test="clientCode != null and clientCode != ''">#{clientCode},</if>
            <if test="clientName != null and clientName != ''">#{clientName},</if>
            <if test="vendorId != null">#{vendorId},</if>
            <if test="vendorCode != null and vendorCode != ''">#{vendorCode},</if>
            <if test="vendorName != null and vendorName != ''">#{vendorName},</if>
            <if test="batchCode != null and batchCode != ''">#{batchCode},</if>
            <if test="requestDate != null">#{requestDate},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="ancestors != null and ancestors != ''">#{ancestors},</if>
            <if test="cancelDate != null">#{cancelDate},</if>
            <if test="finishDate != null">#{finishDate},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <!--
        根据ID修改生产工单：只更新非 null 字段

        注意这里刻意【不更新】下面这些字段：
          quantity_produced  已生产数量，由报工回写，手工改会破坏账实一致
          quantity_scheduled 已排产数量，由排产累加
          status / finish_date / cancel_date 走 updateStatus 专门的状态流转
        业务性字段（类型/来源/产品/数量）在 Service 层按状态判断能不能改。
    -->
    <update id="updateById" parameterType="com.elevn.mes.pro.entity.ProWorkorder">
        update pro_workorder
        <set>
            <if test="workorderCode != null and workorderCode != ''">workorder_code = #{workorderCode},</if>
            <if test="workorderName != null and workorderName != ''">workorder_name = #{workorderName},</if>
            <if test="workorderType != null and workorderType != ''">workorder_type = #{workorderType},</if>
            <if test="orderSource != null and orderSource != ''">order_source = #{orderSource},</if>
            <if test="sourceCode != null">source_code = #{sourceCode},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productCode != null and productCode != ''">product_code = #{productCode},</if>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="productSpc != null">product_spc = #{productSpc},</if>
            <if test="unitOfMeasure != null and unitOfMeasure != ''">unit_of_measure = #{unitOfMeasure},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="quantityChanged != null">quantity_changed = #{quantityChanged},</if>
            <if test="clientId != null">client_id = #{clientId},</if>
            <if test="clientCode != null">client_code = #{clientCode},</if>
            <if test="clientName != null">client_name = #{clientName},</if>
            <if test="vendorId != null">vendor_id = #{vendorId},</if>
            <if test="vendorCode != null">vendor_code = #{vendorCode},</if>
            <if test="vendorName != null">vendor_name = #{vendorName},</if>
            <if test="batchCode != null">batch_code = #{batchCode},</if>
            <if test="requestDate != null">request_date = #{requestDate},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="ancestors != null">ancestors = #{ancestors},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where workorder_id = #{workorderId}
        and del_flag = '0'
    </update>

    <!-- 状态流转：一套 SQL 覆盖下达/完工/取消，靠传入的时间参数是否 null 决定写哪些时间列 -->
    <update id="updateStatus">
        update pro_workorder
        <set>
            status = #{status},
            finish_date = #{finishDate},
            <if test="cancelDate != null">cancel_date = #{cancelDate},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = now()
        </set>
        where workorder_id = #{workorderId}
        and del_flag = '0'
    </update>

    <!-- 累加已排产数量：用 quantity_scheduled + #{quantity} 而不是先查后写，避免并发覆盖 -->
    <update id="addScheduledQuantity">
        update pro_workorder
        set quantity_scheduled = ifnull(quantity_scheduled, 0) + #{quantity},
            update_by = #{updateBy},
            update_time = now()
        where workorder_id = #{workorderId}
        and del_flag = '0'
    </update>

    <!-- 已排产数量归零（撤销排产时调用）
         撤销后该工单已无任何任务，直接置零比做减法更不易算错。 -->
    <update id="resetScheduledQuantity">
        update pro_workorder
        set quantity_scheduled = 0,
            update_by = #{updateBy},
            update_time = now()
        where workorder_id = #{workorderId}
        and del_flag = '0'
    </update>

    <!--
      累加已生产数量（报工时任务完工后调用）
      与 addScheduledQuantity 同理：让数据库做加法，避免"先查后写"在并发下互相覆盖。
    -->
    <update id="addProducedQuantity">
        update pro_workorder
        set quantity_produced = ifnull(quantity_produced, 0) + #{quantity},
            update_by = #{updateBy},
            update_time = now()
        where workorder_id = #{workorderId}
        and del_flag = '0'
    </update>

    <!-- 根据ID删除生产工单：逻辑删除 -->
    <delete id="deleteById">
        update pro_workorder set del_flag = '1'
        where workorder_id = #{id}
        and del_flag = '0'
    </delete>

    <!-- 批量删除：同样走逻辑删除 -->
    <update id="deleteBatch">
        update pro_workorder set del_flag = '1'
        where del_flag = '0'
          and workorder_id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>

    <!-- 多条件查询生产工单：条件为空则该字段不参与过滤 -->
    <select id="selectByCondition" parameterType="com.elevn.mes.pro.entity.ProWorkorder" resultMap="ProWorkorderResultMap">
        select
        <include refid="Base_Column_List"/>
        from pro_workorder
        <where>
            del_flag = '0'
            <if test="workorderId != null">and workorder_id = #{workorderId}</if>
            <if test="workorderCode != null and workorderCode != ''">and workorder_code like concat('%', #{workorderCode}, '%')</if>
            <if test="workorderName != null and workorderName != ''">and workorder_name like concat('%', #{workorderName}, '%')</if>
            <if test="workorderType != null and workorderType != ''">and workorder_type = #{workorderType}</if>
            <if test="orderSource != null and orderSource != ''">and order_source = #{orderSource}</if>
            <if test="sourceCode != null and sourceCode != ''">and source_code like concat('%', #{sourceCode}, '%')</if>
            <if test="productId != null">and product_id = #{productId}</if>
            <if test="productCode != null and productCode != ''">and product_code like concat('%', #{productCode}, '%')</if>
            <if test="productName != null and productName != ''">and product_name like concat('%', #{productName}, '%')</if>
            <if test="clientId != null">and client_id = #{clientId}</if>
            <if test="clientName != null and clientName != ''">and client_name like concat('%', #{clientName}, '%')</if>
            <if test="vendorId != null">and vendor_id = #{vendorId}</if>
            <if test="batchCode != null and batchCode != ''">and batch_code like concat('%', #{batchCode}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="remark != null and remark != ''">and remark like concat('%', #{remark}, '%')</if>
        </where>
        order by workorder_id desc
    </select>

    <!-- 根据工单编码查询（校验编码重复用） -->
    <select id="selectByWorkorderCode" resultMap="ProWorkorderResultMap">
        select
        <include refid="Base_Column_List"/>
        from pro_workorder
        <where>
            del_flag = '0'
            and workorder_code = #{workorderCode}
        </where>
        limit 1
    </select>

    <!-- 根据ID查询单条 -->
    <select id="selectById" resultMap="ProWorkorderResultMap">
        select
        <include refid="Base_Column_List"/>
        from pro_workorder
        <where>
            del_flag = '0'
            and workorder_id = #{id}
        </where>
    </select>

    <!-- 统计工单下的 BOM 行数 -->
    <select id="selectBomCount" resultType="int">
        select count(1) from pro_workorder_bom
        where del_flag = '0'
          and workorder_id = #{workorderId}
    </select>

</mapper>
