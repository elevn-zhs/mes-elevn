<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    工序


    说明：本文件是手写 SQL。逻辑删除需要自己在 SQL 里写 del_flag，
          每条查询都要带 del_flag = '0'，否则会把已删除的数据查出来。
-->
<mapper namespace="com.elevn.mes.pro.mapper.ProProcessMapper">

    <!-- pro_process 表字段与实体属性的映射 -->
    <resultMap id="ProProcessResultMap" type="com.elevn.mes.pro.entity.ProProcess">
        <id column="process_id" property="processId"/>
        <result column="process_code" property="processCode"/>
        <result column="process_name" property="processName"/>
        <result column="attention" property="attention"/>
        <result column="enable_flag" property="enableFlag"/>
        <result column="del_flag" property="delFlag"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 公共字段列表，避免每句 SQL 重复罗列 -->
    <sql id="Base_Column_List">
        process_id, process_code, process_name, attention, enable_flag,
        del_flag, remark, create_by, create_time, update_by,
        update_time
    </sql>

    <!-- 新增工序：字段为 null 时不写入，交给数据库默认值 -->
    <insert id="insert" parameterType="com.elevn.mes.pro.entity.ProProcess" useGeneratedKeys="true" keyProperty="processId">
        insert into pro_process
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="processCode != null and processCode != ''">process_code,</if>
            <if test="processName != null and processName != ''">process_name,</if>
            <if test="attention != null and attention != ''">attention,</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="processCode != null and processCode != ''">#{processCode},</if>
            <if test="processName != null and processName != ''">#{processName},</if>
            <if test="attention != null and attention != ''">#{attention},</if>
            <if test="enableFlag != null and enableFlag != ''">#{enableFlag},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <!-- 根据ID修改工序：只更新非 null 字段；create_by / create_time / del_flag 不参与修改 -->
    <update id="updateById" parameterType="com.elevn.mes.pro.entity.ProProcess">
        update pro_process
        <set>
            <if test="processCode != null and processCode != ''">process_code = #{processCode},</if>
            <if test="processName != null and processName != ''">process_name = #{processName},</if>
            <if test="attention != null">attention = #{attention},</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag = #{enableFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where process_id = #{processId}
        and del_flag = '0'
    </update>

    <!-- 根据ID删除工序：逻辑删除，把 del_flag 置为 1，记录仍然留在库里 -->
    <delete id="deleteById">
        update pro_process set del_flag = '1'
        where process_id = #{id}
        and del_flag = '0'
    </delete>

    <!-- 批量删除：同样走逻辑删除，一次把多个 id 的 del_flag 置为 1 -->
    <update id="deleteBatch">
        update pro_process set del_flag = '1'
        where del_flag = '0'
          and process_id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>

    <!-- 多条件查询工序：条件为空则该字段不参与过滤；始终只查未删除的数据 -->
    <select id="selectByCondition" parameterType="com.elevn.mes.pro.entity.ProProcess" resultMap="ProProcessResultMap">
        select
        <include refid="Base_Column_List"/>
        from pro_process
        <where>
            del_flag = '0'
            <if test="processId != null">and process_id = #{processId}</if>
            <if test="processCode != null and processCode != ''">and process_code like concat('%', #{processCode}, '%')</if>
            <if test="processName != null and processName != ''">and process_name like concat('%', #{processName}, '%')</if>
            <if test="enableFlag != null and enableFlag != ''">and enable_flag = #{enableFlag}</if>
            <if test="remark != null and remark != ''">and remark like concat('%', #{remark}, '%')</if>
        </where>
        order by process_id asc
    </select>

    <!-- 根据编码查询（校验编码重复用） -->
    <select id="selectByProcessCode" resultMap="ProProcessResultMap">
        select
        <include refid="Base_Column_List"/>
        from pro_process
        <where>
            del_flag = '0'
            and process_code = #{processCode}
        </where>
        limit 1
    </select>

    <!-- 根据ID查询单条 -->
    <select id="selectById" resultMap="ProProcessResultMap">
        select
        <include refid="Base_Column_List"/>
        from pro_process
        <where>
            del_flag = '0'
            and process_id = #{id}
        </where>
    </select>

    <!-- 统计工序被下游引用的次数：
         1. 工作站把工序挂为资源（md_workstation.process_id）
         2. 工艺路线的工序明细引用（pro_route_process.process_id）
         两处任何一处引用了，这个工序就不允许删除。
         注意：md_workstation 是 md 模块的表，跨模块引用在这里只体现为 SQL，不需要 Java 依赖。 -->
    <select id="selectReferenceCount" resultType="int">
        select
          (select count(1) from md_workstation where del_flag = '0' and process_id = #{processId})
        + (select count(1) from pro_route_process where del_flag = '0' and process_id = #{processId})
    </select>

</mapper>
